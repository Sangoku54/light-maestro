{
  "name": "light-maestro",
  "version": "1.0.10",
  "description": "Fusion QLC+ & SoundSwitch — DMX lighting control + audio-reactive automation",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && electron .",
    "build": "tsc -p tsconfig.electron.json && vite build && node scripts/copy-static.cjs",
    "test": "vitest run",
    "start": "tsc -p tsconfig.electron.json && vite build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "artnet": "^1.4.0",
    "better-sqlite3": "^12.0.0",
    "dmxnet": "^0.9.0",
    "electron-store": "^11.0.0",
    "electron-updater": "^6.8.9",
    "ftdi-d2xx": "^1.3.1",
    "i18next": "^26.3.2",
    "midi": "^2.0.0",
    "react-i18next": "^17.0.8",
    "sacn": "^4.6.0",
    "serialport": "^13.0.0",
    "uuid": "^9.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.184.1",
    "@types/uuid": "^9.0.0",
    "@types/xml2js": "^0.4.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "lucide-react": "^0.300.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "three": "^0.184.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vitest": "^4.1.10",
    "zustand": "^4.4.0"
  },
  "optionalDependencies": {
    "enttec-open-dmx-usb": "^4.0.0"
  },
  "build": {
    "appId": "com.lightmaestro.app",
    "productName": "Light Maestro",
    "copyright": "Copyright © 2026 Light Maestro",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/midi/**",
      "node_modules/serialport/**",
      "node_modules/@serialport/**",
      "resources/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Light Maestro"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
